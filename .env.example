DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"

# Inngest (background enrichment worker — required on serverless/Vercel)
INNGEST_SIGNING_KEY=""            # from Inngest dashboard → Environment → Keys
INNGEST_EVENT_KEY=""              # from Inngest dashboard → Environment → Keys

# Polar billing (optional — leave empty to disable upgrades)
POLAR_ACCESS_TOKEN=""             # from Settings → Tokens
POLAR_WEBHOOK_SECRET=""           # from Settings → Webhooks → Signing Secret
POLAR_PRODUCT_GROWTH=""           # Growth plan product price ID
POLAR_PRODUCT_AGENCY=""           # Agency plan product price ID
POLAR_SERVER="sandbox"            # "sandbox" or "production"

# Sentry monitoring (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=""          # from Sentry project settings
SENTRY_ORG=""                      # from Sentry organization settings
SENTRY_PROJECT=""                  # from Sentry project settings
