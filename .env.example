DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"

# Google OAuth (required — it's the only sign-in method)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Inngest (background enrichment worker — required on serverless/Vercel)
INNGEST_SIGNING_KEY=""            # from Inngest dashboard → Environment → Keys
INNGEST_EVENT_KEY=""              # from Inngest dashboard → Environment → Keys

# Dodo Payments billing (optional — leave empty to disable upgrades)
DODO_API_KEY=""                     # from Dodo dashboard → Developers → API
DODO_WEBHOOK_SECRET=""              # from Dodo dashboard → Developers → Webhooks
DODO_PRODUCT_GROWTH=""              # Growth plan subscription product ID
DODO_PRODUCT_AGENCY=""              # Agency plan subscription product ID
DODO_ENV="test_mode"                # "test_mode" or "live_mode"

# Sentry monitoring (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=""          # from Sentry project settings
SENTRY_ORG=""                      # from Sentry organization settings
SENTRY_PROJECT=""                  # from Sentry project settings
